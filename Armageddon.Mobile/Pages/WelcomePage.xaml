<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Armageddon.Mobile.Pages.WelcomePage"
             BackgroundColor="#0B0B0B">

    <Grid Padding="24">
        <VerticalStackLayout Spacing="30" VerticalOptions="Center">

            <!-- Title -->
            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                <Label Text="Welcome"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalTextAlignment="Center"/>

                <Label Text="Are you a buyer or seller?"
                       FontSize="14"
                       TextColor="#AAAAAA"
                       HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>

            <!-- BUYER CARD -->
            <Border StrokeShape="RoundRectangle 20"
                    BackgroundColor="#00C853"
                    Padding="24">

                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">

                    <Label Text="🛍️"
                           FontSize="36"
                           HorizontalOptions="Center"/>

                    <Label Text="Buyer"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="Black"
                           HorizontalOptions="Center"/>

                    <Label Text="Get items delivered"
                           FontSize="12"
                           TextColor="#1A1A1A"
                           HorizontalOptions="Center"/>

                </VerticalStackLayout>

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBuyerTapped"/>
                </Border.GestureRecognizers>
            </Border>

            <!-- SELLER CARD -->
            <Border StrokeShape="RoundRectangle 20"
                    BackgroundColor="#2A2A2A"
                    Padding="24">

                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">

                    <Label Text="🏪"
                           FontSize="36"
                           HorizontalOptions="Center"/>

                    <Label Text="Seller"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center"/>

                    <Label Text="Deliver and earn"
                           FontSize="12"
                           TextColor="#BBBBBB"
                           HorizontalOptions="Center"/>

                </VerticalStackLayout>

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSellerTapped"/>
                </Border.GestureRecognizers>
            </Border>

        </VerticalStackLayout>
    </Grid>

</ContentPage>